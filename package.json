{
  "name": "borges",
  "version": "0.1.0",
  "description": "Personal offline PDF and EPUB library for Arch Linux",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.x",
    "pnpm": "12.16.x"
  },
  "scripts": {
    "dev": "pnpm build && electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package:runtime": "pnpm build && node scripts/package-runtime.ts",
    "package:personal": "pnpm build && node scripts/package-runtime.ts --personal",
    "test:delivery": "pnpm package:personal && playwright test --config playwright.delivery.config.ts",
    "test:packaged": "pnpm package:runtime && playwright test tests/packaged --config playwright.packaged.config.ts",
    "measure:runtime": "pnpm package:runtime && playwright test --config playwright.measure.config.ts",
    "measure:personal": "pnpm package:personal && BORGES_MEASURE_ARTIFACT=dist/borges playwright test --config playwright.measure.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
